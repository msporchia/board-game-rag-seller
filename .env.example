# Copy to .env to override defaults (docker compose reads .env automatically).

# --- Models (pulled into Ollama, see README) ---
EMBEDDING_MODEL=nomic-embed-text
LLM_MODEL=llama3.1

# --- Data source for ingest ---
# Default = the bundled mock PrestaShop (offline demo).
PRESTASHOP_BASE_URL=http://mock-prestashop:8001
# Point at a real PrestaShop "seller" endpoint to ingest a live catalog:
# PRESTASHOP_BASE_URL=http://my-prestashop
# SELLER_TOKEN=...          # required by a real endpoint; the mock ignores it

# --- Catalog the mock serves ---
# Default = the committed synthetic sample (mock/sample-catalog.json).
# Point at your own (git-ignored) catalog to serve a full dataset locally:
# MOCK_CATALOG=./mock/catalog.json
